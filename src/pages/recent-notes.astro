---
import { getNotes } from '../utils'
import Layout from '../layouts/Layout.astro'

const notesByDate = (await getNotes())
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
---

<Layout>
  <section class="notes-by-date">
    <h1>Recent Notes</h1>
    <ul>
      {notesByDate.map((note) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}/notes/${note.id}`}>
            {`${note.data.title} `}
          </a>
          <time datetime={note.data.pubDate.toISOString()}>
            {note.data.pubDate.toLocaleDateString()}
          </time>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style is:global>
  .notes-by-date {
    display: flex;
    flex-direction: column;
  }

  .notes-by-date > * {
    padding: 0 1rem;
  }

  .notes-by-date ul li a {
    display: inline-block;
    width: 80%;
  }

  .notes-by-date ul li time {
    display: inline-block;
    width: 20%;
    text-align: right;
  }
</style>
